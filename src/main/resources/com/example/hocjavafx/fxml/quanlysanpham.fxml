<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.hocjavafx.QuanLySanPhamController">

    <top>
        <HBox alignment="CENTER" prefHeight="60.0" style="-fx-background-color: #2c3e50;" BorderPane.alignment="CENTER">
            <children>
                <Label text="QUẢN LÝ SẢN PHẨM" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>
            </children>
        </HBox>
    </top>

    <left>
        <VBox prefWidth="300.0" spacing="20.0" style="-fx-background-color: #ecf0f1;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <Label text="Thông tin chi tiết">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>

                <VBox spacing="5.0">
                    <children>
                        <Label text="Tên sản phẩm:" />
                        <TextField fx:id="txtTenSanPham" promptText="Nhập tên sản phẩm..." style="-fx-pref-height: 35;" />
                    </children>
                </VBox>

                <VBox spacing="5.0">
                    <children>
                        <Label text="Giá (VNĐ):" />
                        <TextField fx:id="txtGiaSanPham" promptText="Nhập giá bán..." style="-fx-pref-height: 35;" />
                    </children>
                </VBox>

                <VBox spacing="5.0">
                    <children>
                        <Label text="Số lượng:" />
                        <TextField fx:id="txtSoLuong" promptText="Nhập số lượng kho..." style="-fx-pref-height: 35;" />
                    </children>
                </VBox>

                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#themSanPham" prefHeight="35.0" prefWidth="80.0" style="-fx-background-color: #27ae60; -fx-cursor: hand;" text="Thêm" textFill="WHITE">
                            <font><Font name="System Bold" size="13.0" /></font>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#suaSanPham" prefHeight="35.0" prefWidth="80.0" style="-fx-background-color: #f39c12; -fx-cursor: hand;" text="Sửa" textFill="WHITE">
                            <font><Font name="System Bold" size="13.0" /></font>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#xoaSanPham" prefHeight="35.0" prefWidth="80.0" style="-fx-background-color: #e74c3c; -fx-cursor: hand;" text="Xóa" textFill="WHITE">
                            <font><Font name="System Bold" size="13.0" /></font>
                        </Button>
                    </children>
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </HBox>

                <VBox alignment="BOTTOM_CENTER" VBox.vgrow="ALWAYS">
                    <children>
                        <Button mnemonicParsing="false" onAction="#quayLai" prefHeight="40.0" prefWidth="260.0" style="-fx-background-color: #34495e; -fx-cursor: hand;" text="&lt; Quay lại Trang Chủ" textFill="WHITE">
                            <font><Font name="System Bold" size="14.0" /></font>
                        </Button>
                    </children>
                </VBox>
            </children>
        </VBox>
    </left>

    <center>
        <TableView fx:id="tableSanPham" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
                <TableColumn fx:id="colTen" prefWidth="250.0" text="Tên Sản Phẩm" />
                <TableColumn fx:id="colGia" prefWidth="150.0" text="Giá Bán (VNĐ)" />
                <TableColumn fx:id="colSoLuong" prefWidth="100.0" text="Tồn Kho" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <BorderPane.margin>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </BorderPane.margin>
        </TableView>
    </center>

</BorderPane>