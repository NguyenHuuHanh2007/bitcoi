<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="650.0" prefWidth="900.0" spacing="15.0" style="-fx-background-color: #f4f7f6;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.hocjavafx.QuanLySanPhamController">
    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
    <Label text="QUẢN LÝ SẢN PHẨM &amp; KHO" textFill="#2c3e50"><font><Font name="System Bold" size="24.0" /></font></Label>

    <GridPane hgap="10" vgap="10" alignment="CENTER">
        <TextField fx:id="txtTenSP" promptText="Tên sản phẩm" prefWidth="250.0" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="txtSoLuong" promptText="Số lượng" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <TextField fx:id="txtTinhTrang" promptText="Tình trạng (VD: Mới 100%, Cũ...)" prefWidth="250.0" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <Button onAction="#chonAnh" text="📁 Chọn Ảnh SP" style="-fx-background-color: #3498db; -fx-text-fill: white;" GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="150.0"/>
        <Label fx:id="lblTenAnh" text="Chưa chọn ảnh..." textFill="#7f8c8d" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
    </GridPane>

    <HBox alignment="CENTER" spacing="15.0">
        <Button onAction="#themSanPham" text="➕ Nhập Kho" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold;" prefHeight="35.0" prefWidth="120.0"/>
        <Button onAction="#dayLenSan" text="⬆️ Đẩy lên Sàn Đấu Giá" style="-fx-background-color: #f1c40f; -fx-font-weight: bold;" prefHeight="35.0" prefWidth="160.0"/>
    </HBox>

    <TableView fx:id="tableSanPham" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colTenSP" prefWidth="200.0" text="Tên Sản Phẩm" />
            <TableColumn fx:id="colGia" prefWidth="120.0" text="Giá Khởi Điểm" />
            <TableColumn fx:id="colSoLuong" prefWidth="80.0" text="Tồn Kho" />
            <TableColumn fx:id="colTrangThai" prefWidth="120.0" text="Trạng Thái" />
        </columns>
    </TableView>
    <Button onAction="#quayLai" text="Quay lại Trang Chủ" style="-fx-background-color: #95a5a6; -fx-text-fill: white;"/>
</VBox>