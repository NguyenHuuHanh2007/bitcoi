<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.hocjavafx.DangKi">
    <children>

        <VBox alignment="CENTER" maxWidth="350.0" spacing="15.0">
            <children>

                <Label text="Đăng kí" textFill="#f20000">
                    <font>
                        <Font size="18.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="10.0" />
                    </VBox.margin>
                </Label>

                <TextField prefHeight="35.0" promptText="Tên truy cập" />
                <TextField prefHeight="35.0" promptText="Mật khẩu" />
                <TextField prefHeight="35.0" promptText="Nhập lại mật khẩu" />
                <TextField prefHeight="35.0" promptText="Email hoặc Số điện thoại" />

                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#dangKiNgay" prefHeight="40.0" text="Đăng Kí Ngay" textFill="#00bbff">
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </Button>

            </children>

            <padding>
                <Insets bottom="30.0" left="20.0" right="20.0" top="30.0" />
            </padding>
        </VBox>

    </children>
</StackPane>
