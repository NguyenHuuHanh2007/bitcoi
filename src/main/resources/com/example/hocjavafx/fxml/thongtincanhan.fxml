<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="400.0" spacing="20.0" style="-fx-background-color: #ecf0f1;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.hocjavafx.ThongTinCaNhanController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <Label text="THÔNG TIN TÀI KHOẢN" textFill="#2c3e50">
        <font>
            <Font name="System Bold" size="24.0" />
        </font>
    </Label>

    <VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;">
        <Label text="Người dùng:" textFill="#7f8c8d">
            <font><Font size="14.0" /></font>
        </Label>
        <Label fx:id="lblTenDangNhap" text="Tên User" textFill="#2c3e50">
            <font><Font name="System Bold" size="18.0" /></font>
        </Label>

        <Label text="Số dư khả dụng:" textFill="#7f8c8d">
            <font><Font size="14.0" /></font>
            <VBox.margin><Insets top="10.0" /></VBox.margin>
        </Label>
        <Label fx:id="lblSoDuTaiKhoan" text="0 VNĐ" textFill="#27ae60">
            <font><Font name="System Bold" size="22.0" /></font>
        </Label>
    </VBox>

    <Button mnemonicParsing="false" onAction="#napTien" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-cursor: hand;" text="Nạp Tiền">
        <font><Font name="System Bold" size="14.0" /></font>
    </Button>

    <Button mnemonicParsing="false" onAction="#rutTien" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-cursor: hand;" text="Rút Tiền">
        <font><Font name="System Bold" size="14.0" /></font>
    </Button>

    <Button mnemonicParsing="false" onAction="#quayLai" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-cursor: hand;" text="Quay lại">
        <font><Font name="System Bold" size="14.0" /></font>
    </Button>
</VBox>