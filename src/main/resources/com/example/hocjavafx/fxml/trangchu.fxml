<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="950.0" style="-fx-background-color: #f4f7f6;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.hocjavafx.TrangChuController">

   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="60.0" style="-fx-background-color: #00AEEF; -fx-padding: 0 20px;">
         <children>
            <Label text="HỆ THỐNG ĐẤU GIÁ TRỰC TUYẾN" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblUsername" text="Xin chào, User!" textFill="WHITE">
               <font>
                  <Font size="15.0" />
               </font>
            </Label>
         </children>
      </HBox>
   </top>

   <left>
      <VBox prefWidth="220.0" spacing="10.0" style="-fx-background-color: #ffffff; -fx-border-color: #e0e0e0; -fx-border-width: 0 1 0 0; -fx-padding: 20px 10px;">
         <children>
            <Button maxWidth="Infinity" prefHeight="45.0" style="-fx-background-color: #e6f7ff; -fx-text-fill: #00AEEF; -fx-font-weight: bold; -fx-cursor: hand;" text="Danh sách đấu giá" />
            <Button maxWidth="Infinity" prefHeight="45.0" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-text-fill: #333333;" text="Phòng đấu giá (Live)" />
            <Button maxWidth="Infinity" onAction="#quanLySanPham" prefHeight="45.0" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-text-fill: #333333;" text="Quản lý sản phẩm" />
            <Button maxWidth="Infinity" prefHeight="45.0" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-text-fill: #333333;" text="Lịch sử giao dịch" />

            <Region VBox.vgrow="ALWAYS" />

            <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#dangXuat" prefHeight="40.0" style="-fx-background-color: #ff4d4f; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Đăng xuất" />
         </children>
      </VBox>
   </left>

   <center>
      <VBox spacing="15.0" style="-fx-padding: 20px;">
         <children>
            <Label text="Danh Sách Phiên Đấu Giá Đang Diễn Ra" textFill="#333333">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>

            <TableView fx:id="tableAuctions" style="-fx-font-size: 14px; -fx-background-color: white;" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colID" prefWidth="60.0" text="Mã SP" />
                  <TableColumn fx:id="colTenSP" prefWidth="250.0" text="Tên Sản Phẩm" />
                  <TableColumn fx:id="colGiaKhoiDiem" prefWidth="120.0" text="Giá Khởi Điểm" />
                  <TableColumn fx:id="colGiaHienTai" prefWidth="120.0" text="Giá Hiện Tại" />
                  <TableColumn fx:id="colThoiGian" prefWidth="150.0" text="Thời Gian Còn Lại" />
                  <TableColumn fx:id="colTrangThai" prefWidth="120.0" text="Trạng Thái" />
               </columns>
            </TableView>

            <HBox alignment="CENTER_RIGHT" spacing="15.0">
               <children>
                  <Button prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-cursor: hand;" text="Xem chi tiết" />
                  <Button prefHeight="35.0" prefWidth="130.0" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Tham Gia Đấu Giá" />
               </children>
            </HBox>
         </children>
      </VBox>
   </center>

</BorderPane>
