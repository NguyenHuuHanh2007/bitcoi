<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" prefWidth="1000" prefHeight="700">

    <!-- HEADER -->
    <top>
        <HBox alignment="CENTER" style="-fx-background-color: linear-gradient(to right, #1e3c72, #2a5298);" spacing="10">
            <padding>
                <Insets top="15" bottom="15"/>
            </padding>
            <Label text="HỆ THỐNG ĐẤU GIÁ" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <!-- LEFT: NGƯỜI BÁN -->
    <left>
        <VBox spacing="15" alignment="TOP_CENTER" style="-fx-background-color: #f4f4f4;" prefWidth="200">
            <padding>
                <Insets top="20"/>
            </padding>

            <Label text="NGƯỜI BÁN" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

            <Button text="Đăng sản phẩm" prefWidth="150"/>
            <Button text="Đặt giá khởi điểm" prefWidth="150"/>
            <Button text="Quản lý phiên đấu" prefWidth="150"/>

        </VBox>
    </left>

    <!-- CENTER: SÀN ĐẤU GIÁ -->
    <center>
        <VBox alignment="CENTER" spacing="20">

            <Label text="SÀN ĐẤU GIÁ TRỰC TUYẾN" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <VBox alignment="CENTER" spacing="10" style="-fx-border-color: gray; -fx-padding: 20;">

                <!-- Hình sản phẩm -->
                <ImageView fitHeight="150" fitWidth="200">
                    <image>
                        <Image url="https://via.placeholder.com/200"/>
                    </image>
                </ImageView>

                <!-- Thời gian -->
                <Label text="00:02:15" style="-fx-font-size: 20px; -fx-text-fill: red;"/>

                <!-- Giá hiện tại -->
                <Label text="Giá hiện tại: 5,500,000 đ"
                       style="-fx-font-size: 16px; -fx-background-color: orange; -fx-padding: 5;"/>

                <!-- Nút điều khiển -->
                <HBox spacing="10">
                    <Button text="Bắt đầu"/>
                    <Button text="Dừng"/>
                </HBox>

            </VBox>

        </VBox>
    </center>

    <!-- RIGHT: NGƯỜI THAM GIA -->
    <right>
        <VBox spacing="15" alignment="TOP_CENTER" style="-fx-background-color: #f9f9f9;" prefWidth="200">
            <padding>
                <Insets top="20"/>
            </padding>

            <Label text="NGƯỜI THAM GIA" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

            <Button text="Đặt giá" prefWidth="150"/>
            <Button text="Theo dõi phiên" prefWidth="150"/>

            <!-- Giá đặt -->
            <Label text="6,000,000 đ" style="-fx-text-fill: green; -fx-font-size: 14px;"/>
            <Label text="5.7 triệu" style="-fx-text-fill: blue; -fx-font-size: 14px;"/>

        </VBox>
    </right>

    <!-- FOOTER -->
    <bottom>
        <HBox alignment="CENTER" spacing="50" style="-fx-background-color: #eeeeee;">
            <padding>
                <Insets top="15" bottom="15"/>
            </padding>

            <Label text="Đấu giá trực tiếp"/>
            <Label text="Giá tăng dần"/>
            <Label text="Thanh toán  nhận hàng"/>

        </HBox>
    </bottom>

</BorderPane>