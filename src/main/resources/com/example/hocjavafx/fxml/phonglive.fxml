<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="550.0" prefWidth="700.0" spacing="15.0" style="-fx-background-color: #2c3e50;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.hocjavafx.PhongLiveController">
    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
    <Label text="🔴 PHÒNG ĐẤU GIÁ TRỰC TIẾP" textFill="#e74c3c"><font><Font name="System Bold" size="24.0" /></font></Label>

    <TextArea fx:id="txtChatLive" editable="false" style="-fx-control-inner-background: #000; -fx-text-fill: #0f0; -fx-font-family: 'Consolas';" VBox.vgrow="ALWAYS" />

    <HBox alignment="CENTER" spacing="10.0">
        <TextField fx:id="txtNhapLieu" promptText="Gõ bình luận hoặc số tiền..." HBox.hgrow="ALWAYS" prefHeight="40.0"/>
        <Button onAction="#thaTim" text="❤️" style="-fx-background-color: #ff7675; -fx-text-fill: white;" prefHeight="40.0"/>
        <Button onAction="#guiBinhLuan" text="Gửi" style="-fx-background-color: #3498db; -fx-text-fill: white;" prefHeight="40.0"/>
        <Button onAction="#raGiaLive" text="RA GIÁ" style="-fx-background-color: #f1c40f; -fx-font-weight: bold;" prefHeight="40.0"/>
    </HBox>
    <Button onAction="#quayLai" text="Rời Phòng" style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
</VBox>